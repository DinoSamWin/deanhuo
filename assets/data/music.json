    {
        "id": "an-bing-bu-dong",
        "title": "按兵不动",
        "artist": "Dean Huo",
        "year": "2025",
        "cover": "assets/images/lyrics/an-bing-bu-dong.jpg",
        "url": "assets/audio/an-bing-bu-dong.mp3",
        "genre": "Ambient",
        "description": "Deep atmospheric textures and submerged rhythms, designed for deep focus and meditation.",
        "lyricId": "an-bing-bu-dong",
        "lyricTimings": {
            "assets/audio/an-bing-bu-dong.mp3": [
                {
                    "time": null,
                    "text": "那边塞的战火 那信使的求和"
                },
                {
                    "time": null,
                    "text": "一品 宰相 乌纱在我眼前左左右的踱"
                },
                {
                    "time": null,
                    "text": "泛黄羊布地图上的邻国"
                },
                {
                    "time": null,
                    "text": "谁等待着我最后援助号令的颁布"
                },
                {
                    "time": null,
                    "text": "谁等待着我十万骑兵的飞扬跋扈"
                },
                {
                    "time": null,
                    "text": "黄土高原沙场开辟出新的血色黄河"
                },
                {
                    "time": null,
                    "text": "我额皇带领布衣白骨打下的社稷"
                },
                {
                    "time": null,
                    "text": "孙子兵法中   这次的弱肉强食"
                },
                {
                    "time": null,
                    "text": "我按兵不动   静坐等待做最后的赢家"
                },
                {
                    "time": null,
                    "text": "马蹄铮铮 谁撑到最后的大漠长河落日圆"
                },
                {
                    "time": null,
                    "text": "吾皇万岁 军师兵部的天才战略毛遂自荐"
                },
                {
                    "time": null,
                    "text": "纸上谈兵 敌动我不动的策略引领战绩向前"
                },
                {
                    "time": null,
                    "text": "暗渡陈仓 你邦国最后的形单影双有谁怜"
                },
                {
                    "time": null,
                    "text": "出其不意最后出场 别怕残局还有我“成吉思汗”"
                },
                {
                    "time": null,
                    "text": "按兵不动的战术淋漓尽致应该和我一样"
                },
                {
                    "time": null,
                    "text": "霍氏兵法什么叫按:隔岸观火 静观其变"
                },
                {
                    "time": null,
                    "text": "我的国度什么称兵:克敌制胜 谈其色变"
                },
                {
                    "time": null,
                    "text": "信使求和决定说不: 坐收渔利 巧施连环"
                },
                {
                    "time": null,
                    "text": "狼烟四起按兵不动:以静制动 王者风范"
                },
                {
                    "time": null,
                    "text": "按兵不动魏进吴退的鹬蚌相争 我比你懂"
                },
                {
                    "time": null,
                    "text": "父皇说自古以来秦时的明月汉时的关"
                },
                {
                    "time": null,
                    "text": "还有卧薪尝胆  最后披荆斩棘的越王勾践"
                },
                {
                    "time": null,
                    "text": "诸侯们割地划城池南北征战西东还有两汉"
                },
                {
                    "time": null,
                    "text": "我对着大漠孤烟笑看反目成仇的两败俱伤"
                },
                {
                    "time": null,
                    "text": "败者为寇胜者为王 我泰若自然静等边关战报"
                },
                {
                    "time": null,
                    "text": "精兵铁骑三万的收场踏遍诸葛空城有我骁勇战将"
                }
            ]
        }
